# --- Datos de participantes: nunca al repositorio ----------------------------
# Viven en TFG/EEG-Data, fuera del repo (variable EEG_DATA). Estas reglas son una
# red de seguridad por si algo se escribe aquí por error.
data/

# Señal EEG
*.edf
*.bdf
*.fif
*.gdf
*.cnt
*.set
*.fdt
*.vhdr
*.vmrk
*.eeg
*.mff
*.mef
*.nwb

# Tablas
*.csv
*.parquet
*.xlsx
*.xls

# Tablas por persona generadas por las líneas de análisis (analisis/<línea>/<paso>/tablas/)
**/tablas/

# Matrices y objetos binarios (NumPy, HDF5, Pickle, MATLAB)
*.npy
*.npz
*.h5
*.hdf5
*.pkl
*.pickle
*.mat

# Pesos de redes de PyTorch (se guardan en EEG-Data). Los modelos que usa la
# plataforma (.joblib y .onnx de src/eeg_library/modelos/) sí se versionan.
*.pt
*.pth

# --- Python -------------------------------------------------------------------
__pycache__/
*.py[codz]
*.egg-info/
build/
dist/

# --- Entornos y configuración local ------------------------------------------
.venv
venv/
.env

# --- Herramientas -------------------------------------------------------------
.pytest_cache/
.ipynb_checkpoints/
.ruff_cache/
.mypy_cache/
.vscode/
.idea/
.claude/settings.local.json

# --- Sistema operativo --------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
